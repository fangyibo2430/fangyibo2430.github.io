---
// Temporary notice shown while the owner's information is being completed.
---

<div class="demo-notice">
  <div class="bar">
    <p>
      <strong>Website in progress.</strong> Fang Yanbin is currently completing
      the information on this academic homepage.
    </p>
  </div>
</div>

<style>
  .demo-notice {
    background: var(--color-surface);
    border-bottom: 1px solid var(--color-divider);
  }
  /* The notice and the button share one row so the button sits at the far
     right of the content column rather than floating over the page. */
  .bar {
    max-width: var(--content-max);
    margin: 0 auto;
    padding: 10px var(--gutter);
    display: flex;
    align-items: center;
    gap: 24px;
  }
  .demo-notice p {
    margin: 0;
    font-size: 14.5px;
    line-height: 1.5;
    color: color-mix(in srgb, var(--color-text) 75%, transparent);
  }
  /* .pill is the outlined button used under papers and entries; the star only
     adds the icon gap and stops the row from squeezing it. */
</style>
