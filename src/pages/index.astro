---
import Base from "../layouts/Base.astro";
import Sidebar from "../components/Sidebar.astro";
import Section from "../components/Section.astro";
import EntryList from "../components/EntryList.astro";
import NewsList from "../components/NewsList.astro";
import PubItem from "../components/PubItem.astro";
import DemoNotice from "../components/DemoNotice.astro";
import { site, absoluteUrl } from "../site.config.js";
import {
  profile,
  about,
  news,
  education,
  publications,
  workingPapers,
  awards,
  teaching,
  lastUpdated,
} from "../data.js";

const title = [profile.nameEn, profile.nameCn].filter(Boolean).join(" ");

// Structured data, assembled from the same content the page renders — nothing
// to keep in sync by hand. Institutions you list an `url` for in `education`
// become `alumniOf`; external profile links become `sameAs`.
const email = profile.links.find((l) => l.href.startsWith("mailto:"))?.href;
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: profile.nameEn,
  ...(profile.nameCn && { alternateName: profile.nameCn }),
  url: absoluteUrl("/"),
  jobTitle: site.seo.jobTitle,
  description: site.description,
  ...(email && { email }),
  ...(site.seo.affiliation && {
    affiliation: { "@type": "CollegeOrUniversity", ...site.seo.affiliation },
  }),
  alumniOf: education
    .filter((e) => e.url && e.org !== site.seo.affiliation?.name)
    .map((e) => ({
      "@type": "CollegeOrUniversity",
      name: e.org,
      sameAs: e.url,
    })),
  ...(site.seo.location && {
    homeLocation: {
      "@type": "Place",
      address: {
        "@type": "PostalAddress",
        addressLocality: site.seo.location.locality,
        addressCountry: site.seo.location.country,
      },
    },
  }),
  knowsAbout: site.seo.knowsAbout,
  sameAs: profile.links
    .filter((l) => /^https?:/.test(l.href))
    .map((l) => l.href),
};
---

<Base title={title} path="/" jsonLd={jsonLd}>
  {site.demoNotice && <DemoNotice repo={site.repo} />}

  <div class="page">
    <Sidebar />

    {/* Every section below disappears on its own when its array in
        src/data.js is empty. To reorder the page, move these blocks. */}
    <main>
      {
        about.length > 0 && (
          <Section id="about" title="About Me">
            <div class="prose">
              {about.map((para) => (
                <p set:html={para} />
              ))}
            </div>
          </Section>
        )
      }

      {
        news.length > 0 && (
          <Section id="news" title="News">
            <NewsList items={news} />
          </Section>
        )
      }

      {
        education.length > 0 && (
          <Section id="education" title="Education">
            <EntryList items={education} />
          </Section>
        )
      }

      {
        publications.length > 0 && (
          <Section id="publications" title="Publications">
            <h3 class="section-subtitle">Conference Publications and Presentations</h3>
            <div class="pubs">
              {publications.map((p) => (
                <PubItem {...p} />
              ))}
            </div>
          </Section>
        )
      }

      {
        workingPapers.length > 0 && (
          <Section id="working-papers" title="Working Papers">
            <div class="pubs">
              {workingPapers.map((p) => (
                <PubItem {...p} />
              ))}
            </div>
          </Section>
        )
      }

      {
        awards.length > 0 && (
          <Section id="awards" title="Awards and Honours">
            <ul class="awards-list">
              {awards.slice(0, 2).map((award) => (
                <li>
                  <strong>{award.org}</strong>
                  {award.role && <span class="muted"> — {award.role}</span>}
                  {award.date && <span class="muted"> ({award.date})</span>}
                </li>
              ))}
            </ul>
          </Section>
        )
      }

      {
        teaching.length > 0 && (
          <Section id="teaching" title="Teaching">
            <EntryList items={teaching} />
          </Section>
        )
      }

      <footer>Last updated {lastUpdated}</footer>
    </main>
  </div>
</Base>
